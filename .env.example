# Copia este archivo como .env y completa los valores.
# Las variables VITE_ se incluyen en el JavaScript público: nunca pongas aquí secretos ni claves privadas.

# Endpoint del formulario de Formspree. Formato: https://formspree.io/f/tu_id
VITE_FORMSPREE_ENDPOINT=

# Número internacional solo con dígitos, sin +, espacios ni símbolos. Formato: 51XXXXXXXXX
VITE_WHATSAPP_NUMBER=

# Correo público de contacto. Si queda vacío se usa contacto@a2technologies.com
VITE_CONTACT_EMAIL=

# Dominio final sin barra al final. Formato: https://www.tudominio.com
VITE_SITE_URL=

# Enlaces de redes de la empresa. Los que queden vacíos se muestran como pendientes, sin enlace.
VITE_LINKEDIN_URL=
VITE_GITHUB_URL=
VITE_INSTAGRAM_URL=
